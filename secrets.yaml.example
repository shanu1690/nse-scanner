# Angel One SmartAPI (free API, replaces direct NSE + yfinance data).
# Setup: https://smartapi.angelbroking.com -> sign in -> developer dashboard
# (My Apps) -> create API key. Then in the Angel One app enable TOTP /
# Google Authenticator; totp_secret is the base32 key from the QR/backup code.
# pin = the 4-digit trading PIN used to log into the Angel One app.
smartapi:
  api_key: "your-api-key"
  client_id: "A123456"
  pin: "1234"
  totp_secret: "BASE32SECRETFROMTOTP"
